# Ma'lumotlar bazasi (prod: PostgreSQL, lokal: sqlite standart)
# DATABASE_URL=postgresql+psycopg2://user:parol@localhost:5432/ainews
DATABASE_URL=sqlite:///./ainews.db

# AI provayder: gemini (standart) yoki claude
AI_PROVIDER=gemini

# Gemini API kaliti — https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-3.5-flash-lite

# Google Cloud serverlari uchun Vertex AI (ixtiyoriy)
# AI_PROVIDER=vertex
# GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/google-credentials.json
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global
# VERTEX_GEMINI_MODEL=gemini-3.7-flash

# Claude (ixtiyoriy, AI_PROVIDER=claude bo'lsa) — https://platform.claude.com
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-opus-4-8

# Admin panel tokeni (kuchli tasodifiy qiymat qo'ying!)
ADMIN_TOKEN=maxfiy-admin-token

# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-...
TELEGRAM_CHANNEL_ID=@ai_news_uz

# Xavfsiz standart: maqolalar admin tasdig'ini kutadi (pending).
# To'liq avtomatik rejim uchun ataylab true qiling.
AUTO_PUBLISH=false
AUTO_PUBLISH_MIN_IMPORTANCE=2

# Muhim yangiliklarni (bahosi >= 4) Telegram kanalga avtomatik yuborish
AUTO_TELEGRAM=true
AUTO_TELEGRAM_MIN_IMPORTANCE=4

# Pipeline har soatda; tahririy kun Toshkent vaqti bo'yicha hisoblanadi.
PIPELINE_INTERVAL=3600
APP_TIMEZONE=Asia/Tashkent
DUPLICATE_LOOKBACK_DAYS=30
FETCH_FULL_ARTICLE=true
FULL_ARTICLE_MIN_SOURCE_CHARS=1800
FULL_ARTICLE_MAX_CHARS=12000
ARTICLE_FETCH_WORKERS=4

# Uvicorn ichida pipeline/botni ham ishga tushirish faqat bitta web-service
# deploymenti uchun. Alohida cron yoki Docker pipeline bo'lsa false qiling.
RUN_BACKGROUND_SERVICES=true

# Rasm topilmaganda (RSS + og:image ham bo'sh) Gemini bilan generatsiya.
# Pullik xizmat — shuning uchun standart o'chiq.
IMAGE_GENERATION=false
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Generatsiya qilingan rasmlarning ommaviy manzili (prod'da domeningiz)
BACKEND_PUBLIC_URL=http://localhost:8000

# Frontend manzili (CORS)
FRONTEND_ORIGIN=http://localhost:3000
